# AEGIS ForkGuard - environment configuration (ALL OPTIONAL)
#
# Copy to .env and fill in if you want the optional semantic layer.
# .env is gitignored; never commit real keys.
#
# With NO key set, ForkGuard runs in fully deterministic demo mode: the
# canonical scenario requires no network access and no API key, and the
# committed decision is identical either way. The LLM can only ADD labeled
# heuristic findings; it can never clear a deterministic verdict or influence
# a commit invariant.

# Set at most one provider key. Precedence: Anthropic > Groq > OpenAI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional model override. Defaults by provider:
#   Anthropic -> claude-sonnet-4-6
#   Groq      -> groq/llama-3.3-70b-versatile
#   OpenAI    -> gpt-4o-mini
FORKGUARD_LLM_MODEL=

# Server port (see also [serve] in jac.toml).
JAC_PORT=8000
